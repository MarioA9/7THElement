--- !u!114 &1391315002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1391315000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a57a41b5a80e1ae4287c1aa4657f7880, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo_Mascota
  teclaActivacion: 102
  panelDialogo: {fileID: 2125783859}
  textoDialogo: {fileID: 619389775}
  imagenDialogo: {fileID: 804429522}
  panelBotones: {fileID: 748660273}
  btnAlimentar: {fileID: 1841806935}
  btnBeber: {fileID: 1761543337}
  btnAcariciar: {fileID: 26484974}
  btnSeguir: {fileID: 1526848148}
  textoBtnSeguir: {fileID: 1590444903}
  barraAmistad: {fileID: 1523345998}
  amistadActual: 0
  amistadMax: 100
  amistadAcariciarMin: 50
  amistadSeguirMin: 100
  sumarAlimentar: 10
  sumarBeber: 10
  sumarAcariciar: 20
  dialogosVozOn:
  - texto: Wow... Una perrita, es muy bonita!!!
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau...
    imagen: {fileID: 0}
    usarImagen: 0
    activarBotones: 0
  - texto: Eres tan tierna... Tienes un collar.
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Bombon?... Con que asi te llamas, es un nombre hermoso, puedo quedarme
      un rato contigo
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 1
  - texto: Jeje, eres tan tierna, me gusta estar mucho contigo
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau!!
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogosVozOn_Repetido:
  - texto: 'Hola de nuevo, veamos que podemos hacer hoy '
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 1
  - texto: Me encanta pasar tiempo contigo, Bombon
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau!!
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  dialogosVozOff:
  - texto: (Wow... Una perrita, es muy bonita!!!)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau?
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  - texto: (Ah, es verdad.... No puedo hablar aun)
    imagen: {fileID: -798638209904432186, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: (Quizas pueda pasar el tiempo con ella)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 1
  - texto: (Es tan tierna, ojala pudiera hablar para decirselo)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 1
  dialogosVozOff_Repetido:
  - texto: (Bien, aqui estamos otra vez, aunque me gustaria poder hablar, veamos
      que podemos hacer)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 1
  - texto: (me encanta pasar tiempo con ella, me la comeria a besos)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogoSinComida_VozOn:
  - texto: Oh, no tengo para darte en este momento, quizas deberia ir a buscar provisiones
      al reino
    imagen: {fileID: 8562560299345383114, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogoSinComida_VozOff:
  - texto: (demonios, no tengo nada, debo ir a algun lugar a buscar provisiones para
      darle)
    imagen: {fileID: 8562560299345383114, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogoNoAcariciar_VozOn:
  - texto: Grrrr...
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  - texto: Uy, parece que aun no confia en mi como para acariciarla
    imagen: {fileID: -798638209904432186, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Deberia ganaerme mas su confianza
    imagen: {fileID: 8562560299345383114, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogoNoAcariciar_VozOff:
  - texto: Grrrr...
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  - texto: (parece que aun no confia en mi)
    imagen: {fileID: -798638209904432186, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: (Tengo que ganaerme mas su confianza)
    imagen: {fileID: -798638209904432186, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogoSeguir_VozOn:
  - texto: Ven, vamos a pasear!!
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau!!
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  dialogoSeguir_VozOff:
  - texto: '*Hace gestos para que la siga* (espero que pueda antender mis gestos)'
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  dialogoEsperar_VozOn:
  - texto: Espera aqui.
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau.
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  dialogoEsperar_VozOff:
  - texto: '*Hace un gesto para que espere aqui*'
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotones: 0
  - texto: Guau.
    imagen: {fileID: 0}
    usarImagen: 1
    activarBotones: 0
  jugadorTransform: {fileID: 1351502434}
  velocidadSeguimiento: 3
  distanciaMinima: 1.5
