    usarImagen: 1
    activarBotonesLago: 0
  - texto: Me pregunto si podre tirarme por aqui... Hmm.
    imagen: {fileID: -3686749547026564867, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotonesLago: 1
  dialogosVozOn_Repetido:
  - texto: "\xBFPor que demonios siento que ya me tire por aqui?"
    imagen: {fileID: -3686749547026564867, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotonesLago: 0
  - texto: Quizas deba ahcerlo otra vez para confirmarlo... o no?
    imagen: {fileID: -3686749547026564867, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarBotonesLago: 1
