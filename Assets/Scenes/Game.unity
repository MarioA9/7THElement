--- !u!114 &1914729087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1914729081}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cd6d032996a5bd4a8fb8b7222b73318, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo_Ritmo
  activarAutomatico: 0
  teclaActivacion: 102
  usarElemental: 0
  objetoElemental: {fileID: 109745796}
  panelDialogo: {fileID: 2125783859}
  textoDialogo: {fileID: 619389775}
  imagenDialogo: {fileID: 804429522}
  velocidadEscritura: 0.03
  noDestruirAlTerminar: 0
  dialogoYaActivado: 0
  dialogosVozOn:
  - texto: Vale, aqui esta mi "Ritmo"...  Es hora de recuperarlo!!
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 1
  - texto: Bien, ya tengo recuperado otro de mis elementos, tengo que seguir con
      mi aventura
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
  dialogosVozOn_Repetido:
  - texto: Ok, un intento mas!!
    imagen: {fileID: -3241302144029496839, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 1
  dialogosVozOff:
  - texto: (Hmm... aqui esta mi "Ritmo", no es la voz pero es bueno recuperarlo,
      es hora de empezar esto)
    imagen: {fileID: -3686749547026564867, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 1
  - texto: (Bien, un elemento recuperado... debo seguir buscando)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
  - texto: (Creo recordar que mi "Voz" no estaba lejos de donde desperte en un bosque)
    imagen: {fileID: 2211485609720563725, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
  miniJuegoRitmo: {fileID: 1854365757}
  dialogoFalloVoz:
  - texto: Demonios, perdi un poco mi toque.
    imagen: {fileID: -798638209904432186, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
  - texto: Pero no debo rendirme, debo seguir intentando hasta lograrlo.
    imagen: {fileID: -798638209904432186, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
  dialogoFalloSinVoz:
  - texto: (Joder, perdi demasiado mi habilidad)
    imagen: {fileID: -3241302144029496839, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
  - texto: (Pero no pienso rendirme, seguire y seguire hasta lograrlo)
    imagen: {fileID: -3241302144029496839, guid: e6d8fef9251fc8c43b49566830bf883c, type: 3}
    usarImagen: 1
    activarMiniJuegoRitmo: 0
